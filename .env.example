NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://app.deliveraexpress.com
TRUST_PROXY=true
FORCE_HTTPS=true

# Ilk admin hesabini sabitlemek istersen doldur.
DELIVERA_ADMIN_USERNAME=admin
DELIVERA_ADMIN_PASSWORD=StrongAdminPassword123!

# Trendyol credential verify icin stage kullanacaksan ac.
TRENDYOL_STAGE_MODE=false

# Diger partnerler icin opsiyonel verify endpointleri.
# DELIVERA_VERIFY_URL_GETIRYEMEK=https://partner.example.com/health
# DELIVERA_VERIFY_URL_YEMEKSEPETI=https://partner.example.com/health
# DELIVERA_VERIFY_URL_MIGROS_YEMEK=https://partner.example.com/health

# Postgres hedefli canli ortam notu:
# Bu surumde uygulama calisma zamaninda SQLite kullanir.
# Postgres'e gecis icin deploy/postgres/ altindaki kurulum notlarini uygula.
# DATABASE_URL=postgres://delivera:password@127.0.0.1:5432/delivera
