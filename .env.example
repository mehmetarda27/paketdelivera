NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://app.deliveraexpress.com
TRUST_PROXY=true
FORCE_HTTPS=true
DELIVERA_CORS_ORIGINS=https://app.deliveraexpress.com

# Production notu:
# Gercek ortamlarda secret'lari bu dosyada tutma; hosting secret manager,
# Docker/Kubernetes secret veya CI/CD protected variable kullan.

# Python platform worker -> Node receiver.
# Use the same value in Node and platform_worker.py environments.
DELIVERA_INTEGRATION_KEY=change-this-long-random-secret
DELIVERA_API_BASE_URL=https://paketdelivera.onrender.com
DATABASE_PATH=./delivera.sqlite
DATABASE_CLIENT=sqlite
DELIVERA_BACKUP_DIR=./backups
DELIVERA_WORKER_CACHE_FILE=./processed_orders.db
DELIVERA_WORKER_POLL_SECONDS=30
DELIVERA_WORKER_ACCOUNT_DELAY_SECONDS=1.2

# Ilk admin hesabini sabitlemek istersen doldur.
DELIVERA_ADMIN_USERNAME=admin
DELIVERA_ADMIN_PASSWORD=StrongAdminPassword123!

# Trendyol credential verify icin stage kullanacaksan ac.
TRENDYOL_STAGE_MODE=false
TRENDYOL_TOKEN_URL=
TRENDYOL_ORDERS_URL=
GETIR_TOKEN_URL=
GETIR_ORDERS_URL=
YEMEKSEPETI_TOKEN_URL=
YEMEKSEPETI_ORDERS_URL=
MIGROS_TOKEN_URL=
MIGROS_ORDERS_URL=

# POS/Adisyo order polling ayarlari.
ADISYO_API_BASE_URL=
ADISYO_POLLING_PATH=/integration/order/sellers/{sellerId}/orders
ADISYO_VERIFY_URL=
ADISYO_POLLING_URL=

# Diger partnerler icin opsiyonel verify endpointleri.
# DELIVERA_VERIFY_URL_GETIRYEMEK=https://partner.example.com/health
# DELIVERA_VERIFY_URL_YEMEKSEPETI=https://partner.example.com/health
# DELIVERA_VERIFY_URL_MIGROS_YEMEK=https://partner.example.com/health

# Postgres hedefli canli ortam notu:
# Bu surumde uygulama calisma zamaninda SQLite kullanir.
# Postgres'e gecis icin deploy/postgres/ altindaki kurulum notlarini uygula.
# DATABASE_URL=postgres://delivera:password@127.0.0.1:5432/delivera

# Redis hedefli canli ortam notu:
# REDIS_URL verilirse rate-limit Redis store'a baglanmayi dener; baglanamazsa memory fallback kullanir.
# BullMQ queue hazirligi da REDIS_URL ile queue olusturabilir, worker runtime ayri devreye alinmalidir.
# REDIS_URL=redis://127.0.0.1:6379/0

# Loglama:
LOG_LEVEL=info

# Platform webhook signature placeholder'lari:
# Gercek secretlari .env.example icine yazma; platform hesap ekraninda veya secret manager'da sakla.
# X-Platform-Signature / X-Webhook-Signature HMAC-SHA256 hex beklenir.

# Platform polling varsayilan olarak kapali kalir. Worker/queue yokken
# canlida webhook akisi tercih edilir.
DELIVERA_PLATFORM_POLLING_ENABLED=false
DELIVERA_PLATFORM_POLLING_INTERVAL_MS=30000

# Operasyonel takip:
# Her HTTP yanitta X-Request-Id doner; upstream proxy varsa kendi
# X-Request-Id degerini gonderebilir.

# Guvenli load smoke varsayilanlari. Production DB'ye yazmaz; temp SQLite kullanir.
# Production ortaminda DELIVERA_LOAD_DB_FILE kullanma; load/smoke test temp SQLite ile calismali.
LOAD_RESTAURANTS=100
LOAD_COURIERS=120
LOAD_PACKAGES=300
LOAD_CONCURRENCY=5,10
