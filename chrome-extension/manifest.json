{
  "manifest_version": 3,
  "name": "Delivera Express Quick Push",
  "version": "1.0.0",
  "description": "Platform panelinden siparis metnini Delivera Express'e gonderir.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.trendyol.com/*",
        "https://*.trendyolgo.com/*",
        "https://*.yemeksepeti.com/*",
        "https://*.yemeksepeti.com.tr/*",
        "https://*.getir.com/*",
        "https://*.getiryemek.com/*",
        "https://*.migros.com.tr/*",
        "https://*.migros.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Delivera Express",
    "default_popup": "popup.html"
  }
}
